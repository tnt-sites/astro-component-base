---
import StructuredData from "@components/utils/StructuredData.astro";
import integrationsData from "@data/integrations.json";
import practiceData from "@data/practice.json";
import seoData from "@data/seo.json";
import "@styles/style.pcss";
import { SEO } from "astro-seo";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  robots?: { noindex?: boolean; nofollow?: boolean } | null;
  article?: {
    type?: "BlogPosting" | "Article" | "NewsArticle";
    title: string;
    description?: string;
    image?: string;
    datePublished: string;
    dateModified?: string;
    authorType?: "Organization" | "Person";
    authorName?: string;
  };
  contentSections?: any;
}

const props = Astro.props;
const formattedTitle = seoData.titleTemplate.replace("{pageTitle}", props.title);
const pageDescription = props.description || seoData.defaultDescription;
const pageImage = props.image || seoData.openGraph.image;
const canonicalPath = props.canonical || Astro.url.pathname;
const canonical = canonicalPath.startsWith("http")
  ? canonicalPath
  : new URL(canonicalPath, seoData.canonicalDomain || Astro.url.origin).href;
const robots = {
  noindex: props.robots?.noindex ?? seoData.robots.noindex,
  nofollow: props.robots?.nofollow ?? seoData.robots.nofollow,
};

// Global settings contract (2026-07-26): GA4 comes from integrations.json
// (populated per-site by WP2Astro convert, or edited in CloudCannon's
// "Integrations" collection) with an optional env override for local
// testing -- never a hardcoded fallback ID (see
// Wp2Astro-codex/GLOBAL-SETTINGS-ENGINE-HANDOFF.md's "no hardcoded
// analytics fallback" exclusion).
const ga4 = import.meta.env.PUBLIC_GA4_ID || integrationsData.analytics.ga4;
const validGa4 = /^G-[A-Z0-9]+$/.test(ga4) ? ga4 : "";
const ga4Bootstrap = validGa4
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag("js", new Date());
gtag("config", ${JSON.stringify(validGa4)});`
  : "";
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href={seoData.faviconSource || "/favicon.svg"} />
    <meta name="generator" content={Astro.generator} />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
      }
    </script>

    <SEO
      title={formattedTitle}
      description={pageDescription}
      canonical={canonical}
      noindex={robots.noindex}
      nofollow={robots.nofollow}
      openGraph={{
        basic: {
          title: formattedTitle,
          type: props.article ? "article" : "website",
          image: pageImage,
          url: canonical,
        },
        optional: {
          description: pageDescription,
        },
      }}
    />

    <StructuredData practice={practiceData} seo={seoData} canonical={canonical} article={props.article} />

    {validGa4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${validGa4}`}></script>}
    {validGa4 && <script is:inline set:html={ga4Bootstrap}></script>}

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import "@choctawnationofoklahoma/lite-vimeo";
      import "@justinribeiro/lite-youtube";
    </script>
  </body>
</html>
