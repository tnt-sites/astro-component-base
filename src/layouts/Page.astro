---
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import Components from "@components/utils/renderBlock.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    metaTitle?: string;
    metaDescription?: string;
    seo?: {
      metaTitle?: string;
      metaDescription?: string;
      canonical?: string;
      openGraphImage?: string;
      openGraphImageAlt?: string;
      robots?: {
        noindex?: boolean;
        nofollow?: boolean;
      };
    };
    pageSections?: any[];
    /** P0.4 (WP2Astro v4 packet, 2026-07-21): page carries its own local
     * header/footer chrome (e.g. a Canvas landing page) -- suppress the
     * shared nav/footer instead of rendering both. */
    suppressNav?: boolean;
    suppressFooter?: boolean;
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  mainNav?: Record<string, any>;
  footer?: Record<string, any>;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  mainNav = mainNavData,
  footer = footerData,
} = Astro.props as Props;

const title = frontmatter?.seo?.metaTitle ?? frontmatter?.metaTitle ?? frontmatter?.title ?? titleProp ?? "";
const description =
  frontmatter?.seo?.metaDescription ??
  frontmatter?.metaDescription ??
  frontmatter?.description ??
  descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.seo?.openGraphImage ?? frontmatter?.image ?? imageProp;
const canonical = frontmatter?.seo?.canonical ?? frontmatter?.canonical ?? canonicalProp;
const robots = frontmatter?.seo?.robots;
const pageSections = frontmatter?.pageSections;
const hasPageSections = pageSections && pageSections.length > 0;
const hasSlotContent = Astro.slots.has("default");
const suppressNav = frontmatter?.suppressNav ?? false;
const suppressFooter = frontmatter?.suppressFooter ?? false;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
  robots={robots}
>
  {!suppressNav && (
    <header>
      <MainNavigation {...mainNav} />
    </header>
  )}
  <main data-pagefind-body>
    {
      hasPageSections ? (
        <Components contentSections={pageSections} propName="pageSections" />
      ) : hasSlotContent ? (
        <slot />
      ) : null
    }
  </main>
  {!suppressFooter && <Footer {...footer} />}
</Layout>
