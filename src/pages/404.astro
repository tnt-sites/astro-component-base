---
// Built to /404.html. The go-live .htaccess serves it with
// `ErrorDocument 404 /404.html`, so a missing address returns a real 404.
import Page from "@layouts/Page.astro";
import { getCollection } from "astro:content";

const pages = await getCollection("pages");
const paths = new Set(pages.map((page) => "/" + page.id.replace(/(^|\/)index$/, "").replace(/\/$/, "")));
const pick = (...options: string[]) => options.find((path) => paths.has(path));
const links = [
  { label: "Return to Home", href: "/" },
  { label: "Contact Us", href: pick("/contact", "/contact-us") },
  {
    label: "Request an Appointment",
    href: pick("/request-an-appointment", "/appointment", "/appointments", "/schedule-an-appointment"),
  },
  { label: "Sitemap", href: pick("/sitemap") },
].filter((link) => link.href);

const frontmatter = {
  title: "Page Not Found",
  seo: { robots: { noindex: true, nofollow: false } },
};
---

<Page frontmatter={frontmatter}>
  <section class="page-404">
    <h1>Page Not Found</h1>
    <p>Sorry, the page you requested is not available. It may have been moved, renamed, or no longer exists.</p>
    <p>Please use one of the links below, or contact us if you need help finding what you&rsquo;re looking for.</p>
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </section>
</Page>

<style>
  .page-404 {
    max-width: 48rem;
    margin-inline: auto;
    padding: 4rem 1.5rem 5rem;
  }
  .page-404 ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }
  .page-404 a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
