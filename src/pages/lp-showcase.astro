---
import LandingHeaderCircleIcons from "@navigation/landing/landing-header-circle-icons/LandingHeaderCircleIcons.astro";
import LandingHeaderFourCol from "@navigation/landing/landing-header-four-col/LandingHeaderFourCol.astro";
import LandingHeaderPediatricWaves from "@navigation/landing/landing-header-pediatric-waves/LandingHeaderPediatricWaves.astro";
import LandingHeaderSplit from "@navigation/landing/landing-header-split/LandingHeaderSplit.astro";
import LandingHeaderTwoLocations from "@navigation/landing/landing-header-two-locations/LandingHeaderTwoLocations.astro";
import LandingHeader from "@navigation/landing/landing-header/LandingHeader.astro";

import LandingFooterLogoTop from "@navigation/landing/landing-footer-logo-top/LandingFooterLogoTop.astro";
import LandingFooterMapGrid from "@navigation/landing/landing-footer-map-grid/LandingFooterMapGrid.astro";
import LandingFooterOverlappingMap from "@navigation/landing/landing-footer-overlapping-map/LandingFooterOverlappingMap.astro";
import LandingFooterPediatricWaves from "@navigation/landing/landing-footer-pediatric-waves/LandingFooterPediatricWaves.astro";
import LandingFooterThreeCards from "@navigation/landing/landing-footer-three-cards/LandingFooterThreeCards.astro";
import LandingFooterTitleHr from "@navigation/landing/landing-footer-title-hr/LandingFooterTitleHr.astro";
import LandingFooterTMJ from "@navigation/landing/landing-footer-tmj/LandingFooterTMJ.astro";
import LandingFooterTopBar from "@navigation/landing/landing-footer-top-bar/LandingFooterTopBar.astro";
import LandingFooter from "@navigation/landing/landing-footer/LandingFooter.astro";

const logo = "/images/logo.svg";

const buttonSections = [
  {
    _component: "building-blocks/core-elements/button",
    text: "Request an Appointment",
    hideText: false,
    link: "/request-an-appointment/",
    iconName: "",
    iconPosition: "before",
    variant: "primary",
    size: "md",
    width: "md",
  },
];

const mapEmbedUrl =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3068.786482745663!2d-104.9902517239723!3d39.723202471561745!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x876c7e2c38b3b2f5%3A0x8fa949f50f9c1921!2sDenver!5e0!3m2!1sen!2sus!4v1710000000000!5m2!1sen!2sus";

const officesOne = [
  {
    name: "Main Office",
    phones: [{ display: "(555) 123-4567", href: "tel:+15551234567" }],
    addresses: [
      {
        lines: ["123 Main Street", "Suite 200"],
        city: "Denver",
        state: "CO",
        postalCode: "80202",
        mapUrl: "https://maps.google.com/?q=123+Main+Street+Denver+CO+80202",
      },
    ],
    officeHours: [
      { day: "Monday", hours: "8:00am - 5:00pm" },
      { day: "Tuesday", hours: "8:00am - 5:00pm" },
      { day: "Wednesday", hours: "8:00am - 5:00pm" },
      { day: "Thursday", hours: "8:00am - 5:00pm" },
      { day: "Friday", hours: "8:00am - 2:00pm" },
    ],
    officeHoursNote: "Closed weekends.",
    mapEmbedUrl,
  },
];

const officesTwo = [
  officesOne[0],
  {
    name: "West Office",
    phones: [{ display: "(555) 987-6543", href: "tel:+15559876543" }],
    addresses: [
      {
        lines: ["456 Oak Avenue"],
        city: "Lakewood",
        state: "CO",
        postalCode: "80214",
        mapUrl: "https://maps.google.com/?q=456+Oak+Avenue+Lakewood+CO+80214",
      },
    ],
    officeHours: [
      { day: "Monday", hours: "7:30am - 4:30pm" },
      { day: "Tuesday", hours: "7:30am - 4:30pm" },
      { day: "Wednesday", hours: "7:30am - 4:30pm" },
      { day: "Thursday", hours: "7:30am - 4:30pm" },
      { day: "Friday", hours: "7:30am - 1:00pm" },
    ],
    mapEmbedUrl,
  },
];

const legalLinks = [
  { name: "Privacy Policy", path: "/privacy-policy/" },
  { name: "Sitemap", path: "/sitemap/" },
];

const featuredServicesLinks = [
  { name: "Invisalign", path: "/invisalign/" },
  { name: "Dental Implants", path: "/dental-implants/" },
  { name: "Emergency Dentistry", path: "/emergency/" },
];

const showcaseHeaders = [
  {
    title: "Landing Header",
    component: LandingHeader,
    props: { logoSource: logo, logoAlt: "Logo", offices: officesOne, pageButtons: buttonSections },
  },
  {
    title: "Landing Header Split",
    component: LandingHeaderSplit,
    props: { logoSource: logo, logoAlt: "Logo", offices: officesOne, pageButtons: buttonSections },
  },
  {
    title: "Landing Header Two Locations",
    component: LandingHeaderTwoLocations,
    props: { logoSource: logo, logoAlt: "Logo", offices: officesTwo, pageButtons: buttonSections },
  },
  {
    title: "Landing Header Circle Icons",
    component: LandingHeaderCircleIcons,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      offices: officesOne,
      pageButtons: [{ ...buttonSections[0], iconName: "icon-calendar-1" }],
    },
  },
  {
    title: "Landing Header Pediatric Waves",
    component: LandingHeaderPediatricWaves,
    props: { logoSource: logo, logoAlt: "Logo", offices: officesOne, pageButtons: buttonSections },
  },
  {
    title: "Landing Header Four Col",
    component: LandingHeaderFourCol,
    props: { logoSource: logo, logoAlt: "Logo", offices: officesOne, pageButtons: buttonSections },
  },
];

const showcaseFooters = [
  {
    title: "Landing Footer",
    component: LandingFooter,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      offices: officesOne,
      legalLinks,
      mapEmbedUrl,
    },
  },
  {
    title: "Landing Footer Logo Top",
    component: LandingFooterLogoTop,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      offices: officesOne,
      legalLinks,
      mapEmbedUrl,
    },
  },
  {
    title: "Landing Footer Map Grid",
    component: LandingFooterMapGrid,
    props: {
      siteName: "Demo Dental",
      offices: officesTwo,
      legalLinks,
      heading: "Find Our Offices",
    },
  },
  {
    title: "Landing Footer Overlapping Map",
    component: LandingFooterOverlappingMap,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      offices: officesOne,
      legalLinks,
      mapEmbedUrl,
    },
  },
  {
    title: "Landing Footer Three Cards",
    component: LandingFooterThreeCards,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      offices: officesOne,
      legalLinks,
      featuredServicesLinks,
      mapEmbedUrl,
    },
  },
  {
    title: "Landing Footer Title HR",
    component: LandingFooterTitleHr,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      offices: officesOne,
      legalLinks,
      mapEmbedUrl,
    },
  },
  {
    title: "Landing Footer TMJ",
    component: LandingFooterTMJ,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      offices: officesOne,
      legalLinks,
      getStartedText: "Schedule your evaluation and bring your questions.",
      formAction: "#",
    },
  },
  {
    title: "Landing Footer Pediatric Waves",
    component: LandingFooterPediatricWaves,
    props: { logoSource: logo, logoAlt: "Logo", offices: officesOne, legalLinks },
  },
  {
    title: "Landing Footer Top Bar",
    component: LandingFooterTopBar,
    props: {
      logoSource: logo,
      logoAlt: "Logo",
      siteName: "Demo Dental",
      contactTitle: "Contact Us",
      offices: officesOne,
      legalLinks,
      mapEmbedUrl,
      backgroundColor: "brand-secondary",
    },
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Landing Header/Footer Showcase</title>
  </head>
  <body>
    <main class="showcase-page">
      <h1>Landing Header and Footer Showcase</h1>

      <section>
        <h2>Headers</h2>
        {
          showcaseHeaders.map((item) => {
            const Component = item.component;
            return (
              <div class="showcase-block">
                <h3>{item.title}</h3>
                <Component {...item.props} />
              </div>
            );
          })
        }
      </section>

      <section>
        <h2>Footers</h2>
        {
          showcaseFooters.map((item) => {
            const Component = item.component;
            return (
              <div class="showcase-block">
                <h3>{item.title}</h3>
                <Component {...item.props} />
              </div>
            );
          })
        }
      </section>
    </main>
  </body>
</html>

<style>
  .showcase-page {
    background: #f5f7fa;
    color: #111827;
    font-family: Avenir, Helvetica, Arial, sans-serif;
    margin: 0;
    padding: 2rem 1rem 4rem;
  }

  .showcase-page > h1 {
    font-size: 2rem;
    margin: 0 auto 1.5rem;
    max-width: 1320px;
  }

  .showcase-page section {
    margin: 0 auto;
    max-width: 1320px;
  }

  .showcase-page section + section {
    margin-top: 2.5rem;
  }

  .showcase-page h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }

  .showcase-block {
    border: 1px solid #d1d5db;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .showcase-block > h3 {
    background: #111827;
    color: #fff;
    font-size: 1rem;
    letter-spacing: 0.03em;
    margin: 0;
    padding: 0.75rem 1rem;
  }
</style>
