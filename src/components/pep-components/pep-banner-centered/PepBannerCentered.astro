---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Text from "@components/building-blocks/core-elements/text/Text.astro";
import Heading from "@core-elements/heading/Heading.astro";

const {
  heading = "",
  headingFontFamily = "",
  contentStyle = "paragraph",
  text = "",
  listItems = [],
  showDivider = true,
  paddingVertical = "md",
  backgroundColor = "base",
  backgroundColorHex = "",
  headingColor = "",
  dividerColor = "",
  textColor = "",
  checkColor = "",
  checkmarkShadowColor = "",
  checkmarkShadowColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const resolvedCheckmarkShadow =
  checkmarkShadowColorHex || checkmarkShadowColor || "var(--color-brand, #000)";

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--pep-centered-heading-color: ${headingColor}` : "",
  dividerColor ? `--pep-centered-divider-color: ${dividerColor}` : "",
  textColor ? `--pep-centered-text-color: ${textColor}` : "",
  checkColor ? `--pep-centered-check-color: ${checkColor}` : "",
  `--pep-centered-check-shadow-color: ${resolvedCheckmarkShadow}`,
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pep-banner-centered", className]}
  paddingVertical={paddingVertical}
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="pep-banner-centered__inner">
    <Heading
      text={heading}
      level="h1"
      class="pep-banner-centered__heading"
      fontFamily={headingFontFamily}
      data-prop="heading"
      editable={true}
    />
    {showDivider && <hr class="pep-banner-centered__divider" />}
    {
      contentStyle === "checklist"
        ? listItems.length > 0 && (
            <ul class="pep-banner-centered__list" data-prop="listItems">
              {listItems.map((item: string) => (
                <li set:html={item} />
              ))}
            </ul>
          )
        : text && <Text text={text} class="pep-banner-centered__text" data-prop="text" />
    }
  </div>
</CustomSection>

<style>
  .pep-banner-centered {
    text-align: center;
  }

  .pep-banner-centered__inner {
    margin: 0 auto;
    max-width: 75rem;
  }

  .pep-banner-centered__heading {
    color: var(--pep-centered-heading-color, var(--color-brand-secondary, var(--color-brand)));
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 0;
    text-align: center;
  }

  .pep-banner-centered__divider {
    border: 0;
    border-bottom: 4px solid
      var(
        --pep-centered-divider-color,
        var(--pep-centered-heading-color, var(--color-brand-secondary, var(--color-brand)))
      );
    display: block;
    margin: 1.25rem auto 1.75rem;
    width: 4.6875rem;
  }

  .pep-banner-centered__text :global(p) {
    color: var(--pep-centered-text-color, var(--color-text));
    font-size: clamp(1.125rem, 2vw, 1.625rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.45;
    margin: 0 0 1.25rem;
    text-align: center;
  }

  .pep-banner-centered__text :global(p:last-child) {
    margin-bottom: 0;
  }

  .pep-banner-centered__list {
    display: table;
    list-style: none;
    margin: 0 auto;
    max-width: 62.5rem;
    padding: 0;
    text-align: left;
  }

  .pep-banner-centered__list li {
    color: var(--pep-centered-text-color, var(--color-text));
    font-size: clamp(1.125rem, 2vw, 1.75rem);
    line-height: 1.35;
    margin: 0 0 1rem;
    padding-left: 3rem;
    position: relative;
  }

  .pep-banner-centered__list li::before {
    color: var(--pep-centered-check-color, var(--color-brand-secondary, var(--color-brand)));
    content: "\2713";
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    left: 0;
    line-height: 1;
    position: absolute;
    text-shadow: 2px 2px 0 var(--pep-centered-check-shadow-color);
    top: -0.15em;
  }

  .pep-banner-centered__list li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 740px) {
    .pep-banner-centered__heading {
      font-size: clamp(2.5rem, 10vw, 3.25rem);
    }

    .pep-banner-centered__text :global(p) {
      font-size: 1.125rem;
    }

    .pep-banner-centered__list li {
      padding-left: 2.4rem;
    }
  }
</style>
