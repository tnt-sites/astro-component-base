---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";

const {
  heading = "",
  headingFontFamily = "",
  listItems = [],
  backgroundColor = "base",
  backgroundColorHex = "",
  headingColor = "",
  textColor = "",
  checkColor = "",
  paddingVertical = "md",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--pep-list-heading-color: ${headingColor}` : "",
  textColor ? `--pep-list-text-color: ${textColor}` : "",
  checkColor ? `--pep-list-check-color: ${checkColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pep-banner-list", className]}
  paddingVertical={paddingVertical}
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="pep-banner-list__inner">
    <Heading
      text={heading}
      level="h1"
      class="pep-banner-list__heading"
      fontFamily={headingFontFamily}
      data-prop="heading"
      editable={true}
    />

    {
      listItems.length > 0 && (
        <ul class="pep-banner-list__items">
          {listItems.map((item: string) => (
            <li set:html={item} />
          ))}
        </ul>
      )
    }
  </div>
</CustomSection>

<style>
  .pep-banner-list {
    text-align: center;
  }

  .pep-banner-list__inner {
    margin: 0 auto;
    max-width: 75rem;
  }

  .pep-banner-list__heading {
    color: var(--pep-list-heading-color, var(--color-brand-secondary, var(--color-brand)));
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.08;
    margin: 0 auto 1.75rem;
    text-align: center;
  }

  .pep-banner-list__items {
    display: table;
    list-style: none;
    margin: 0 auto;
    max-width: 62.5rem;
    padding: 0;
    text-align: left;
  }

  .pep-banner-list__items li {
    color: var(--pep-list-text-color, var(--color-text));
    font-size: clamp(1.125rem, 2vw, 1.75rem);
    line-height: 1.35;
    margin: 0 0 1rem;
    padding-left: 3rem;
    position: relative;
  }

  .pep-banner-list__items li::before {
    color: var(--pep-list-check-color, var(--color-brand-secondary, var(--color-brand)));
    content: "\2713";
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    left: 0;
    line-height: 1;
    position: absolute;
    text-shadow: 2px 2px 0 var(--color-brand, #000);
    top: -0.15em;
  }

  .pep-banner-list__items li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 740px) {
    .pep-banner-list__heading {
      font-size: clamp(2.4rem, 10vw, 3.25rem);
      margin-bottom: 1.5rem;
    }

    .pep-banner-list__items li {
      padding-left: 2.4rem;
    }
  }
</style>
