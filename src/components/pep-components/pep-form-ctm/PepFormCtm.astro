---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  callText = "",
  phone = "",
  phoneLabel = "",
  image = { source: "", alt: "" },
  figcaption = "",
  iframeSrc = "",
  bottomText = "",
  backgroundColor = "none",
  backgroundColorHex = "",
  contentBackgroundColor = "",
  contentBackgroundColorHex = "",
  callBackgroundColor = "",
  callBackgroundColorHex = "",
  linkColor = "",
  class: className,
  ...rest
} = Astro.props;

const resolvedContentBg =
  contentBackgroundColorHex || contentBackgroundColor || "var(--color-bg-surface, #f0f0f0)";
const resolvedCallBg =
  callBackgroundColorHex || callBackgroundColor || "var(--color-bg-base, #fff)";

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  `--pfc-content-bg: ${resolvedContentBg}`,
  `--pfc-call-bg: ${resolvedCallBg}`,
  linkColor ? `--pfc-link-color: ${linkColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pep-form-ctm", className]}
  paddingVertical="xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="pep-form-ctm__content">
    <div class="pep-form-ctm__call">
      {
        image?.source && (
          <figure class="pep-form-ctm__figure">
            <Image
              source={image.source}
              alt={image.alt || ""}
              rounded={false}
              editable={true}
              aspectRatio="none"
              sizes="(max-width: 890px) 100vw, 485px"
              data-prop-src="image.source"
              data-prop-alt="image.alt"
            />
            {figcaption && <figcaption data-prop="figcaption">{figcaption}</figcaption>}
          </figure>
        )
      }
      <article class="pep-form-ctm__article">
        <p data-prop="callText">
          <Fragment set:html={callText} />
          {
            phone && (
              <a
                href={`tel:${phone.replace(/\D/g, "").replace(/^(\d)/, "+1$1")}`}
                class="pep-form-ctm__phone"
              >
                {phoneLabel || phone}
              </a>
            )
          }
        </p>
      </article>
    </div>
    {
      iframeSrc && (
        <div class="pep-form-ctm__form">
          <iframe
            class="ctm-widget"
            src={iframeSrc}
            style="border:none;width:100%;"
            title="Appointment Request Form"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
  {
    bottomText && (
      <div class="pep-form-ctm__bottom">
        <p data-prop="bottomText" set:html={bottomText} />
      </div>
    )
  }
</CustomSection>

<style>
  .pep-form-ctm__content {
    background-color: var(--pfc-content-bg);
    margin: 0 auto;
    max-width: 1260px;
  }

  /* ── Call row ─────────────────────────────────────────────────────────────── */
  .pep-form-ctm__call {
    align-items: center;
    background-color: var(--pfc-call-bg);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    padding: 2.5rem 0.625rem;
  }

  .pep-form-ctm__figure {
    flex: 0 0 485px;
    position: relative;
  }

  .pep-form-ctm__figure figcaption {
    background-color: rgba(255, 255, 255, 0.8);
    bottom: 0;
    font-size: 1.25rem;
    font-weight: 700;
    left: 0;
    letter-spacing: 0.1em;
    padding: 0.3125rem 0.9375rem;
    position: absolute;
    text-transform: uppercase;
    width: 100%;
  }

  .pep-form-ctm__article {
    flex: 0 1 730px;
  }

  .pep-form-ctm__article p {
    color: var(--color-text, #000);
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 3.5vw, 2.8125rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.35;
    padding: 0.625rem;
    text-align: left;
  }

  .pep-form-ctm__phone {
    color: var(--pfc-link-color, var(--color-brand));
  }

  .pep-form-ctm__phone:hover {
    color: var(--color-brand-secondary, var(--color-brand));
  }

  /* ── Form iframe ──────────────────────────────────────────────────────────── */
  .pep-form-ctm__form {
    background-color: var(--pfc-content-bg);
    padding: 0;
  }

  .ctm-widget {
    display: block;
    height: 550px;
    width: 100%;
  }

  /* ── Bottom text ──────────────────────────────────────────────────────────── */
  .pep-form-ctm__bottom {
    padding: 2.5rem 1rem 3rem;
    text-align: center;
  }

  .pep-form-ctm__bottom p {
    color: var(--color-text-inverse, #fff);
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 auto;
    max-width: 1100px;
  }

  /* ── Responsive ───────────────────────────────────────────────────────────── */
  @media (max-width: 890px) {
    .pep-form-ctm__call {
      flex-wrap: wrap;
      justify-content: center;
      padding: 1.875rem 0.625rem 0.625rem;
    }

    .pep-form-ctm__figure {
      flex: 0 1 100%;
      max-width: 485px;
    }
  }

  @media (max-width: 820px) {
    .ctm-widget {
      height: 725px;
    }
  }

  @media (max-width: 740px) {
    .pep-form-ctm__call {
      display: block;
      text-align: center;
    }

    .pep-form-ctm__article p {
      text-align: center;
    }
  }
</style>
