---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import siteInfo from "@data/siteInfo.json";
import Hidden from "@forms/hidden/Hidden.astro";
import Input from "@forms/input/Input.astro";
import Select from "@forms/select/Select.astro";
import Submit from "@forms/submit/Submit.astro";
import Textarea from "@forms/textarea/Textarea.astro";

const {
  heading = "Request an Appointment",
  subtext = `Thank you for your interest in ${siteInfo.siteName}. Please fill out your information in the form below and a member of our team will reach out to you soon.`,
  formAction = "",
  submitText = "Send",
  subjectLine = `New Patient Request an Appointment - ${siteInfo.siteName}`,
  redirectUrl = "thanks.html",
  backgroundColor = "base",
  id = "",
  backgroundImage,
  backgroundGradient = "",
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["landing-page-form", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundImage={backgroundImage}
  style={backgroundGradient ? "--section-bg-gradient: " + backgroundGradient : undefined}
  {...htmlAttributes}
>
  <Heading level="h2" size="xl" alignX="center" data-prop="heading" text={heading} />
  {subtext && <Text alignX="center" data-prop="subtext" text={subtext} />}
  <form class="lp-form form" method="post" action={formAction}>
    <Input name="Name" label="Name" placeholder="Name" required={true} />
    <Input name="Phone" label="Phone Number" placeholder="Phone" required={true} />
    <Input name="email" label="Email Address" type="email" placeholder="Email" required={true} />
    <Select
      name="Patient"
      label="Are you a new or existing patient?"
      placeholder="Are You A New Or Existing Patient?"
      options={[
        { value: "New Patient", label: "New Patient" },
        { value: "Existing Patient", label: "Existing Patient" },
      ]}
    />
    <Select
      name="Discover"
      label="How did you hear about us?"
      placeholder="How Did You Hear About Us?"
      options={[
        { value: "search engine", label: "Search Engine" },
        { value: "family", label: "Family/Friend" },
        { value: "promotion", label: "Promotion" },
        { value: "social media", label: "Social Media" },
        { value: "other", label: "Other" },
      ]}
    />
    <Textarea name="CommentArea" label="Comments" placeholder="Comments" />
    <Submit text={submitText} />
    <Hidden name="_subject" value={subjectLine} />
    <Hidden name="_redirect" value={redirectUrl} />
  </form>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-page-form {
      background: var(--section-bg-gradient, linear-gradient(transparent, transparent));

      .lp-form {
        margin: var(--spacing-2xl) auto var(--spacing-lg);
        max-width: 550px;

        .label {
          display: none;
        }

        .field {
          background-color: #d3d3d3;
          border: none;
          border-radius: 5px;
          box-shadow: inset 0 1px 3px 0 rgba(0, 0, 0, 0.5);
          color: #000;
          font-size: 16px;
          padding: 15px;
          width: 100%;

          &:focus {
            background-color: #e3e3e3;
            outline: #0e345e solid thin;
          }
        }

        .textarea .field {
          height: 200px;
        }

        .submit {
          display: block;
          margin: auto;
          width: 200px;
        }
      }
    }
  }
</style>
