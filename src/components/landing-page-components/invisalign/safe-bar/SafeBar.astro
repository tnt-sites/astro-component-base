---
import CustomSection from "@builders/custom-section/CustomSection.astro";

const {
  text = "New Patients Welcome!",
  secondaryText = "Same Day Appointments",
  separator = "•",
  backgroundColor = "#adc3c3",
  textColor = "#000000",
  class: className,
  ...rest
} = Astro.props;

const styleVars = [`--invis-safe-bg: ${backgroundColor}`, `--invis-safe-color: ${textColor}`].join(
  "; "
);

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["invis-safe-bar", className]}
  paddingVertical="none"
  paddingHorizontal="none"
  backgroundColor="none"
  style={styleVars}
  {...htmlAttributes}
>
  <p>
    {text}
    <span>{separator}</span>
    {secondaryText}
  </p>
</CustomSection>

<style>
  .invis-safe-bar {
    background: var(--invis-safe-bg, #adc3c3);
  }

  .invis-safe-bar :global(.content) {
    max-width: 100%;
    padding: 9px 10px;
  }

  .invis-safe-bar p {
    color: var(--invis-safe-color, #000);
    font-family: josefin-sans, var(--font-body);
    font-size: 18px;
    letter-spacing: 0.15em;
    line-height: 1.2;
    margin: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .invis-safe-bar span {
    margin: 0 10px;
  }

  @media (max-width: 1000px) {
    .invis-safe-bar p {
      font-size: 15px;
    }

    .invis-safe-bar span {
      display: block;
      font-size: 0;
      margin: 0;
    }
  }
</style>
