---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "Patients Love Us",
  reviewText = "",
  author = "",
  reviewsUrl = "#",
  reviewsButtonText = "Read More Reviews",
  sliderHeading = "Actual Patient Results",
  sliderSubheading = "Before & After",
  beforeImage = { source: "", alt: "Before" },
  afterImage = { source: "", alt: "After" },
  starColor = "#fcd800",
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  backgroundColor = "base",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  accentColor ? `--cos-accent-color: ${accentColor}` : "",
  headingColor ? `--cos-heading-color: ${headingColor}` : "",
  fontHeadings ? `--cos-font-headings: ${fontHeadings}` : "",
  starColor ? `--cos-star-color: ${starColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  id="cos-reviews"
  class:list={["cos-reviews", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={backgroundColor}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <!-- Review quote column -->
    <div class="review-col">
      {heading && <h2 set:html={heading} />}
      <div class="stars" aria-label="5 stars">★★★★★</div>
      {reviewText && <p class="comment">&ldquo;{reviewText}&rdquo;</p>}
      {author && <p class="author">– {author}</p>}
      {
        reviewsUrl && (
          <p>
            <a href={reviewsUrl} target="_blank" rel="noopener" class="btn-reviews">
              {reviewsButtonText}
            </a>
          </p>
        )
      }
    </div>

    <!-- Before/After slider column -->
    <div class="slider-col">
      {
        (sliderHeading || sliderSubheading) && (
          <h2 class="slider-title">
            {sliderHeading && <span class="slider-label">{sliderHeading}</span>}
            {sliderSubheading && <Fragment set:html={sliderSubheading} />}
          </h2>
        )
      }
      <div class="ba-wrapper" aria-label="Before and after comparison slider">
        <div class="ba-images" id="cos-ba-images">
          {
            afterImage?.source && (
              <Image
                source={afterImage.source}
                alt={afterImage.alt || "After"}
                rounded={false}
                editable={true}
                aspectRatio="none"
                sizes="auto"
                widths={[]}
                class="ba-after"
                data-prop-src="afterImage.source"
                data-prop-alt="afterImage.alt"
              />
            )
          }
          {
            beforeImage?.source && (
              <div class="ba-before-clip" id="cos-ba-clip" style="width:50%">
                <Image
                  source={beforeImage.source}
                  alt={beforeImage.alt || "Before"}
                  rounded={false}
                  editable={true}
                  aspectRatio="none"
                  sizes="auto"
                  widths={[]}
                  class="ba-before"
                  data-prop-src="beforeImage.source"
                  data-prop-alt="beforeImage.alt"
                />
              </div>
            )
          }
          <div
            class="ba-handle"
            id="cos-ba-handle"
            role="slider"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            aria-label="Before/After divider"
            tabindex="0"
          >
            <div class="ba-handle-icon">
              <span class="ba-arrow ba-arrow--left" aria-hidden="true">&#9664;</span>
              <span class="ba-arrow ba-arrow--right" aria-hidden="true">&#9654;</span>
            </div>
          </div>
        </div>
        <input
          type="range"
          class="ba-range"
          min="0"
          max="100"
          value="50"
          aria-label="Slide to compare before and after"
        />
      </div>
    </div>
  </div>
</CustomSection>

<style>
  .cos-reviews .flex-ed {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: center;
    margin: auto;
    max-width: 1100px;
  }

  /* ── Review column ───────────────────────────────────────────────────────── */
  .cos-reviews .review-col {
    flex: 0 1 380px;
    min-width: 240px;
    text-align: center;
  }

  .cos-reviews .review-col h2 {
    color: var(--cos-heading-color, var(--color-heading, #0f0d0d));
    font-family: var(--cos-font-headings, var(--font-headings));
    font-size: clamp(2rem, 4vw, 3.125rem);
    font-weight: 300;
    line-height: 1.1;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .cos-reviews .stars {
    color: var(--cos-star-color, #fcd800);
    font-size: 1.6rem;
    letter-spacing: 0.15em;
    margin: 0 0 0.75rem;
  }

  .cos-reviews .comment {
    font-size: 1rem;
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .cos-reviews .author {
    color: var(--cos-accent-color, var(--color-brand, #af8c57));
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0 0 1.25rem;
    text-transform: uppercase;
  }

  .cos-reviews .btn-reviews {
    background-color: var(--cos-accent-color, var(--color-brand, #af8c57));
    color: #fff;
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s;
  }

  .cos-reviews .btn-reviews:hover {
    background-color: var(--color-heading, #405465);
  }

  /* ── Slider column ───────────────────────────────────────────────────────── */
  .cos-reviews .slider-col {
    flex: 0 1 480px;
    min-width: 280px;
    text-align: center;
  }

  .cos-reviews .slider-title {
    color: var(--cos-heading-color, var(--color-heading, #0f0d0d));
    font-family: var(--cos-font-headings, var(--font-headings));
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    line-height: 1.2;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .cos-reviews .slider-label {
    color: var(--cos-accent-color, var(--color-brand, #af8c57));
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* ── Before/After wrapper ────────────────────────────────────────────────── */
  .cos-reviews .ba-wrapper {
    position: relative;
    user-select: none;
  }

  .cos-reviews .ba-images {
    overflow: hidden;
    position: relative;
  }

  .cos-reviews .ba-after :global(img),
  .cos-reviews .ba-before :global(img) {
    display: block;
    height: auto;
    pointer-events: none;
    width: 100%;
  }

  .cos-reviews .ba-before-clip {
    height: 100%;
    left: 0;
    overflow: hidden;
    position: absolute;
    top: 0;
  }

  .cos-reviews .ba-before-clip :global(img) {
    max-width: none;
    width: auto;
  }

  /* ── Drag handle ─────────────────────────────────────────────────────────── */
  .cos-reviews .ba-handle {
    align-items: center;
    bottom: 0;
    cursor: ew-resize;
    display: flex;
    justify-content: center;
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 3px;
    z-index: 10;
  }

  .cos-reviews .ba-handle::before {
    background: #fff;
    bottom: 0;
    content: "";
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 2px;
  }

  .cos-reviews .ba-handle-icon {
    align-items: center;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.4);
    display: flex;
    gap: 0.25rem;
    height: 2.5rem;
    justify-content: center;
    position: relative;
    width: 2.5rem;
    z-index: 11;
  }

  .cos-reviews .ba-arrow {
    color: var(--cos-accent-color, var(--color-brand, #af8c57));
    font-size: 0.7rem;
  }

  /* ── Range input (invisible, overlaid for interaction) ───────────────────── */
  .cos-reviews .ba-range {
    appearance: none;
    cursor: ew-resize;
    height: 100%;
    left: 0;
    margin: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 20;
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .cos-reviews .flex-ed {
      flex-direction: column;
    }

    .cos-reviews .review-col,
    .cos-reviews .slider-col {
      flex: none;
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".cos-reviews .ba-wrapper").forEach((wrapper) => {
    const clip = wrapper.querySelector<HTMLElement>("#cos-ba-clip, .ba-before-clip");
    const handle = wrapper.querySelector<HTMLElement>("#cos-ba-handle, .ba-handle");
    const range = wrapper.querySelector<HTMLInputElement>(".ba-range");
    if (!clip || !handle || !range) return;

    const update = (pct: number) => {
      const clamped = Math.min(100, Math.max(0, pct));
      clip.style.width = `${clamped}%`;
      handle.style.left = `${clamped}%`;
      handle.setAttribute("aria-valuenow", String(Math.round(clamped)));
      range.value = String(Math.round(clamped));
    };

    range.addEventListener("input", () => update(Number(range.value)));

    // Keyboard support on the handle
    handle.addEventListener("keydown", (e: KeyboardEvent) => {
      const current = Number(range.value);
      if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
        e.preventDefault();
        update(current - 1);
      } else if (e.key === "ArrowRight" || e.key === "ArrowUp") {
        e.preventDefault();
        update(current + 1);
      }
    });

    // Sync clip image width to container so it doesn't stretch
    const syncBeforeWidth = () => {
      const containerW = (clip.parentElement as HTMLElement)?.offsetWidth ?? 0;
      const beforeImg = clip.querySelector<HTMLElement>("img, picture");
      if (beforeImg) beforeImg.style.width = `${containerW}px`;
    };

    new ResizeObserver(syncBeforeWidth).observe(clip.parentElement as HTMLElement);
    syncBeforeWidth();

    // Initialize
    update(50);
  });
</script>
