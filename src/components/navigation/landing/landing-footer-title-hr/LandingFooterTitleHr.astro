---
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "Logo",
  siteName = "",
  contactTitle = "Contact Us",
  findUsTitle = "Find Us",
  officeHoursTitle = "Office Hours",
  offices = [],
  mapEmbedUrl = "",
  officeHoursNote = "",
  legalLinks = [],
  legalBlurb = "",
  backgroundColor = "",
  backgroundColorHex = "",
  headingColor = "",
  headingColorHex = "",
  id: elementId,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);
const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const copyYear = new Date().getFullYear();

const firstOffice = resolvedOffices[0];
const firstPhone = firstOffice?.phones?.[0];
const firstAddress = firstOffice?.addresses?.[0];

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const addressLines = firstAddress ? formatAddressLines(firstAddress) : [];

const officeHoursEntries: { day: string; hours: string }[] = Array.isArray(firstOffice?.officeHours)
  ? firstOffice.officeHours
      .filter((e: any) => e?.day || e?.hours)
      .map((e: any) => ({ day: e?.day ?? "", hours: e?.hours ?? "" }))
  : [];

const resolvedOfficeHoursNote =
  (typeof officeHoursNote === "string" && officeHoursNote.trim()) ||
  (typeof firstOffice?.officeHoursNote === "string" && firstOffice.officeHoursNote.trim()) ||
  "";

const bgColorMap: Record<string, string> = {
  none: "transparent",
  base: "var(--color-bg-base)",
  surface: "var(--color-bg-surface)",
  accent: "var(--color-bg-accent)",
  highlight: "var(--color-bg-highlight)",
  dark: "var(--color-bg-dark, #2a2a2a)",
  black: "var(--color-bg-inverse, #000)",
};

const headingColorMap: Record<string, string> = {
  brand: "var(--color-brand)",
  "brand-secondary": "var(--color-brand-secondary)",
  dark: "var(--color-text)",
  white: "var(--color-text-inverse)",
};

const resolvedBg = backgroundColorHex || bgColorMap[backgroundColor] || "";
const resolvedHeadingColor = headingColorHex || headingColorMap[headingColor] || "";

const cssVars = [
  resolvedBg && `--lfth-bg: ${resolvedBg}`,
  resolvedHeadingColor && `--lfth-heading-color: ${resolvedHeadingColor}`,
]
  .filter(Boolean)
  .join("; ");

const embedSrc = typeof mapEmbedUrl === "string" ? mapEmbedUrl.trim() : "";
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";
---

<footer
  class:list={["landing-footer-title-hr", className]}
  id={elementId || undefined}
  style={cssVars || undefined}
  {...htmlAttributes}
>
  <div class="lfth-inner">
    <article class="lfth-col lfth-contact">
      <h3 class="lfth-heading" data-prop="contactTitle">{contactTitle}</h3>
      <hr class="lfth-hr" />
      {logoSource && <img src={logoSource} alt={logoAlt} class="lfth-logo" loading="lazy" />}
      {
        addressLines.length > 0 && (
          <a
            href={firstAddress?.mapUrl || "#"}
            class="lfth-address"
            target="_blank"
            rel="noopener noreferrer"
          >
            {addressLines.map((line: string, i: number) => (
              <>
                {line}
                {i < addressLines.length - 1 && <br />}
              </>
            ))}
          </a>
        )
      }
      {
        firstPhone?.display && (
          <a href={firstPhone?.href || "#"} class="lfth-phone">
            {firstPhone.display}
          </a>
        )
      }
    </article>

    {
      embedSrc && (
        <article class="lfth-col lfth-map">
          <h3 class="lfth-heading" data-prop="findUsTitle">
            {findUsTitle}
          </h3>
          <hr class="lfth-hr" />
          <div class="lfth-map-embed">
            <iframe
              src={embedSrc}
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Office location map"
            />
          </div>
        </article>
      )
    }

    {
      officeHoursEntries.length > 0 && (
        <article class="lfth-col lfth-hours">
          <h3 class="lfth-heading" data-prop="officeHoursTitle">
            {officeHoursTitle}
          </h3>
          <hr class="lfth-hr" />
          <div class="lfth-hours-list">
            {officeHoursEntries.map((entry) => (
              <div class="lfth-hours-row">
                <label>{entry.day}</label>
                <span>{entry.hours}</span>
              </div>
            ))}
          </div>
          {resolvedOfficeHoursNote && (
            <p class="lfth-hours-note" data-prop="officeHoursNote">
              {resolvedOfficeHoursNote}
            </p>
          )}
        </article>
      )
    }
  </div>

  <div class="lfth-legal">
      <span>
        &copy; {copyYear}
        {displaySiteName}
      </span>

                 <br class="inline lg:hidden" />
            <span class="mx-2 hidden lg:inline-block">|</span>
      {
        legalLinks.map((item: any) => (
          <a href={item?.path || "#"}>{item?.name || "Link"}</a> <span class="mx-2">|</span>
        ))
      }
      <br class="inline lg:hidden" />
      Site designed and maintained by <a href="https://www.tntdental.com" target="blank">TNT Dental</a>


          {
      blurb && (
        <p class="copy-blurb uppercase text-center mt-12">
          {blurb}
        </p>
      )
    }
  </div>
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-footer-title-hr {
      background-color: var(--lfth-bg, #fff);
      padding-top: 1.875rem;

      .lfth-inner {
        align-items: flex-start;
        display: flex;
        justify-content: space-around;
        margin-inline: auto;
        max-width: 1280px;
        padding-inline: var(--spacing-md);
      }

      .lfth-col {
        flex: 0 1 380px;
        margin: 10px;
        padding: 10px;
        text-align: center;
      }

      .lfth-map {
        flex: 0 1 460px;
      }

      .lfth-heading {
        color: var(--lfth-heading-color, #121618);
        font-family: var(--font-heading, sans-serif);
        font-size: clamp(1.75rem, 3vw, 2.8rem);
        font-weight: 400;
        margin-block: 10px 0;
      }

      .lfth-hr {
        background-color: var(--lfth-heading-color, #403530);
        border: none;
        display: block;
        height: 4px;
        margin: 20px auto 30px;
        width: 75px;
      }

      .lfth-logo {
        display: block;
        margin: 0 auto 1rem !important;
        max-width: 100%;
        padding-top: 1.875rem;
      }

      .lfth-address {
        color: #121212;
        display: block;
        font-size: 1rem;
        font-weight: 400;
        letter-spacing: 0.45px;
        line-height: 1.625;
        padding-top: 2.1875rem;
        text-decoration: none;

        &:hover {
          color: var(--color-brand, #95982d);
        }
      }

      .lfth-phone {
        color: var(--color-brand, #95982d);
        display: block;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 700;
        letter-spacing: 0.5px;
        line-height: 1;
        margin: 20px auto 30px;
        text-decoration: none;

        &:hover {
          color: var(--color-brand-secondary, #4a7290);
        }
      }

      .lfth-map-embed {
        iframe {
          display: block;
          height: 300px;
          width: 100%;
        }
      }

      .lfth-hours-list {
        margin: 3.75rem auto 1.875rem;
        max-width: 310px;
        text-align: left;
      }

      .lfth-hours-row {
        display: flex;
        justify-content: space-between;
        margin: 8px 0;

        label,
        span {
          font-family: var(--font-heading, sans-serif);
          font-size: 1.1875rem;
        }
      }

      .lfth-hours-note {
        font-family: var(--font-heading, sans-serif);
        font-size: 1.1875rem;
        margin-inline: auto;
        max-width: 310px;
        text-align: left;
      }

      .lfth-legal {
        color: #000;
        font-size: 1rem;
        margin-top: 20px;
        padding: 10px 10px 25px;
        text-align: center;

        p {
          margin: 0;
        }

        span {
          padding: 0 5px;
        }

        a {
          color: var(--color-brand, #95982d);
          text-decoration: none;

          &:hover {
            color: var(--color-brand-secondary, #4a7290);
          }
        }
      }

      .lfth-legal-blurb {
        font-size: 0.875rem;
        margin-top: 8px;
        opacity: 0.8;
      }

      @media (max-width: 590px) {
        .lfth-inner {
          display: block;
        }

        .lfth-map {
          display: none;
        }
      }
    }
  }
</style>
