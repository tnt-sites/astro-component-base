---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  logoSource,
  logoAlt = "Logo",
  pageButtons = [],
  offices = [],
  mobileCallSmallText = "Call Today!",
  mobileApptLabel = "Request an Appointment",
  mobileApptHref = "",
  mobileCallBackgroundColor = "",
  mobileCallBackgroundColorHex = "",
  mobileApptBackgroundColor = "",
  mobileApptBackgroundColorHex = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  id: elementId,
  class: className,
  ...htmlAttributes
} = Astro.props as {
  logoSource?: string;
  logoAlt?: string;
  pageButtons?: any[];
  offices?: any[];
  mobileCallSmallText?: string;
  mobileApptLabel?: string;
  mobileApptHref?: string;
  mobileCallBackgroundColor?: string;
  mobileCallBackgroundColorHex?: string;
  mobileApptBackgroundColor?: string;
  mobileApptBackgroundColorHex?: string;
  addressLinkColor?: string;
  addressLinkHoverColor?: string;
  phoneLinkColor?: string;
  phoneLinkHoverColor?: string;
  id?: string;
  class?: string;
  [key: string]: any;
};

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const buttons = (Array.isArray(pageButtons) ? pageButtons : []).map((button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
}));

const colorTokenMap: Record<string, string> = {
  brand: "var(--color-brand)",
  "brand-secondary": "var(--color-brand-secondary)",
  "brand-tertiary": "var(--color-brand-muted)",
  dark: "var(--color-text)",
  white: "var(--color-text-inverse)",
};

const mobilePhone = resolvedOffices[0]?.phones?.[0] ?? null;
const resolvedMobileApptLabel = mobileApptLabel || buttons[0]?.text || "";
const mobileApptLink = buttons[0]?.link || mobileApptHref;
const mobileApptLabelParts =
  typeof resolvedMobileApptLabel === "string" ? resolvedMobileApptLabel.trim().split(/\s+/) : [];
const mobileApptFirstLine = mobileApptLabelParts[0] || "";
const mobileApptSecondLine = mobileApptLabelParts.slice(1).join(" ");
const resolvedMobileCallBg =
  mobileCallBackgroundColorHex || colorTokenMap[mobileCallBackgroundColor] || "";
const resolvedMobileApptBg =
  mobileApptBackgroundColorHex || colorTokenMap[mobileApptBackgroundColor] || "";
const resolvedAddressLinkColor = colorTokenMap[addressLinkColor] || "";
const resolvedAddressLinkHoverColor = colorTokenMap[addressLinkHoverColor] || "";
const resolvedPhoneLinkColor = colorTokenMap[phoneLinkColor] || "";
const resolvedPhoneLinkHoverColor = colorTokenMap[phoneLinkHoverColor] || "";
const cssVars = [
  resolvedMobileCallBg && `--lhs-mobile-call-bg: ${resolvedMobileCallBg}`,
  resolvedMobileApptBg && `--lhs-mobile-appt-bg: ${resolvedMobileApptBg}`,
  resolvedAddressLinkColor && `--lhs-address-link-color: ${resolvedAddressLinkColor}`,
  resolvedAddressLinkHoverColor &&
    `--lhs-address-link-hover-color: ${resolvedAddressLinkHoverColor}`,
  resolvedPhoneLinkColor && `--lhs-phone-link-color: ${resolvedPhoneLinkColor}`,
  resolvedPhoneLinkHoverColor && `--lhs-phone-link-hover-color: ${resolvedPhoneLinkHoverColor}`,
]
  .filter(Boolean)
  .join("; ");
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  id={elementId || undefined}
  class:list={["landing-header-split", className]}
  style={cssVars || undefined}
  {...htmlAttributes}
>
  <div class="landing-header-split-inner">
    <div class="landing-header-split-contact">
      {
        resolvedOffices.map((office: any) => (
          <div class="landing-header-split-office">
            {Array.isArray(office?.phones) &&
              office.phones.map((phone: any) =>
                phone?.display ? (
                  <a href={phone?.href || "#"} class="landing-header-split-phone">
                    {phone?.label ? `${phone.label}: ` : ""}
                    {phone.display}
                  </a>
                ) : null
              )}

            {Array.isArray(office?.addresses) &&
              office.addresses.map((address: any) => {
                const formattedLines = formatAddressLines(address);

                return formattedLines.length > 0 ? (
                  <a
                    href={address?.mapUrl || "#"}
                    class="landing-header-split-address"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {formattedLines.map((line: string, index: number) => (
                      <>
                        {line}
                        {index < formattedLines.length - 1 && <br />}
                      </>
                    ))}
                  </a>
                ) : null;
              })}
          </div>
        ))
      }
    </div>

    <a class="landing-header-split-logo-link" href="/">
      <Image source={logoSource} class="landing-header-split-logo" alt={logoAlt} editable={false} />
    </a>

    {
      buttons.length > 0 && (
        <div class="landing-header-split-buttons">
          <ButtonGroup
            direction="row"
            align="center"
            class="landing-header-split-button-group"
            buttonSections={buttons}
            editable={false}
          />
        </div>
      )
    }
  </div>

  <div class="landing-header-split-mobile-bar">
    {
      mobilePhone?.display && (
        <a href={mobilePhone.href || "#"} class="landing-header-split-mobile-call">
          <small class="landing-header-split-mobile-small">{mobileCallSmallText}</small>
          {mobilePhone.display}
        </a>
      )
    }
    {
      resolvedMobileApptLabel && (
        <a href={mobileApptLink || "#"} class="landing-header-split-mobile-appt">
          {mobileApptFirstLine && <span>{mobileApptFirstLine}</span>}
          {mobileApptSecondLine && <span>{mobileApptSecondLine}</span>}
        </a>
      )
    }
  </div>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-header-split {
      .landing-header-split-inner {
        align-items: center;
        display: grid;
        gap: var(--spacing-md);
        grid-template-columns: 1fr;
        padding-block: var(--spacing-sm);

        @media (min-width: 1024px) {
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        }
      }

      .landing-header-split-contact {
        text-align: left;

        @media (min-width: 1024px) {
          justify-self: start;
        }
      }

      .landing-header-split-logo-link {
        display: inline-flex;
        justify-self: center;
        order: -1;

        @media (min-width: 1024px) {
          order: 0;
        }
      }

      .landing-header-split-logo {
        margin: 0 !important;
      }

      .landing-header-split-phone,
      .landing-header-split-address {
        display: block;
        text-decoration: none;
      }

      .landing-header-split-phone {
        color: var(--lhs-phone-link-color, var(--color-text));

        &:hover,
        &:focus-visible {
          color: var(--lhs-phone-link-hover-color, var(--color-link-hover));
        }
      }

      .landing-header-split-address {
        color: var(--lhs-address-link-color, var(--color-text));

        &:hover,
        &:focus-visible {
          color: var(--lhs-address-link-hover-color, var(--color-link-hover));
        }
      }

      .landing-header-split-phone {
        font-weight: var(--font-weight-semibold);
      }

      .landing-header-split-address {
        margin-top: var(--spacing-2xs);
      }

      .landing-header-split-buttons {
        @media (max-width: 1023px) {
          display: none;
        }

        @media (min-width: 1024px) {
          justify-self: end;
        }
      }

      .landing-header-split-button-group {
        justify-content: flex-start;

        @media (min-width: 1024px) {
          justify-content: flex-end;
        }
      }

      .landing-header-split-mobile-bar {
        display: flex;
        width: 100%;

        @media (min-width: 1024px) {
          display: none;
        }

        a {
          align-items: center;
          color: #fff;
          display: flex;
          flex: 1;
          flex-direction: column;
          font-weight: var(--font-weight-semibold);
          justify-content: center;
          padding-block: var(--spacing-sm);
          text-align: center;
          text-decoration: none;
        }

        .landing-header-split-mobile-call {
          background-color: var(--lhs-mobile-call-bg, var(--color-brand-secondary));
        }

        .landing-header-split-mobile-appt {
          background-color: var(--lhs-mobile-appt-bg, var(--color-brand));
          text-transform: uppercase;
        }

        .landing-header-split-mobile-appt span {
          display: block;
        }

        .landing-header-split-mobile-small {
          display: block;
          font-size: 0.75rem;
          font-weight: var(--font-weight-normal);
          text-transform: uppercase;
        }
      }
    }
  }
</style>
