---
import FontelloIcon from "@core-elements/fontello-icon/FontelloIcon.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  logoSource,
  logoAlt = "Logo",
  pageButtons = [],
  offices = [],
  backgroundColorHex = "",
  iconBackgroundColorHex = "",
  linkColorHex = "",
  mobileCallSmallText = "Call Today!",
  mobileApptLabel = "Request an Appointment",
  mobileApptHref = "#main-form",
  _component,
  class: className,
  ...htmlAttributes
} = Astro.props as {
  logoSource?: string;
  logoAlt?: string;
  pageButtons?: any[];
  offices?: any[];
  backgroundColorHex?: string;
  iconBackgroundColorHex?: string;
  linkColorHex?: string;
  mobileCallSmallText?: string;
  mobileApptLabel?: string;
  mobileApptHref?: string;
  _component?: string;
  class?: string;
  [key: string]: any;
};

const normalizedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const normalizedPageButtons = (Array.isArray(pageButtons) ? pageButtons : []).map(
  (button: any) => ({
    ...button,
    text: typeof button?.text === "string" ? button.text : "",
  })
);

const cssVars = [
  backgroundColorHex && `--lhci-bg: ${backgroundColorHex}`,
  iconBackgroundColorHex && `--lhci-icon-bg: ${iconBackgroundColorHex}`,
  linkColorHex && `--lhci-link-color: ${linkColorHex}`,
]
  .filter(Boolean)
  .join("; ");

const firstPhone = normalizedOffices[0]?.phones?.[0];
const mobileCallHref = firstPhone?.href || "#";
const mobileCallDisplay = firstPhone?.display || "";
const mobileApptLink = normalizedPageButtons[0]?.link || mobileApptHref;
---

<header
  class:list={["landing-header-ci", className]}
  style={cssVars || undefined}
  {...htmlAttributes}
>
  <div class="lhci-nav">
    <a class="lhci-logo-link" href="/">
      <Image source={logoSource} class="lhci-logo" alt={logoAlt} editable={false} />
    </a>

    <div class="lhci-contact">
      {
        normalizedOffices.map((office: any) => (
          <div class="lhci-office">
            {Array.isArray(office?.addresses) &&
              office.addresses.map((address: any) => {
                const lines = formatAddressLines(address);

                return lines.length > 0 ? (
                  <a
                    href={address?.mapUrl || "#"}
                    class="lhci-address"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="lhci-icon-badge" aria-hidden="true">
                      <FontelloIcon name="icon-location" size="sm" />
                    </span>
                    <span class="lhci-link-text">
                      {lines.map((line: string, i: number) => (
                        <>
                          {line}
                          {i < lines.length - 1 && <br />}
                        </>
                      ))}
                    </span>
                  </a>
                ) : null;
              })}

            {Array.isArray(office?.phones) &&
              office.phones.map((phone: any) =>
                phone?.display ? (
                  <a href={phone?.href || "#"} class="lhci-phone">
                    <span class="lhci-icon-badge" aria-hidden="true">
                      <FontelloIcon name="icon-phone" size="sm" />
                    </span>
                    <span class="lhci-link-text lhci-phone-text">
                      {phone?.label ? `${phone.label}: ` : ""}
                      {phone.display}
                    </span>
                  </a>
                ) : null
              )}
          </div>
        ))
      }
    </div>

    {
      normalizedPageButtons.length > 0 && (
        <div class="lhci-buttons">
          <ButtonGroup
            direction="row"
            alignX="end"
            class="lhci-button-group"
            buttonSections={normalizedPageButtons}
            editable={false}
          />
        </div>
      )
    }
  </div>

  <div class="lhci-mobile-bar">
    {
      mobileCallDisplay && (
        <a href={mobileCallHref} class="lhci-mobile-call">
          <small class="lhci-mobile-small">{mobileCallSmallText}</small>
          {mobileCallDisplay}
        </a>
      )
    }
    <a href={mobileApptLink} class="lhci-mobile-appt">
      {mobileApptLabel}
    </a>
  </div>
</header>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-header-ci {
      background-color: var(--lhci-bg, #fff);

      .lhci-nav {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);
        justify-content: space-between;
        margin-inline: auto;
        max-width: 1470px;
        padding-block: var(--spacing-sm);
        padding-inline: var(--spacing-lg);
      }

      .lhci-logo-link {
        display: inline-flex;
        flex-shrink: 0;
      }

      .lhci-logo {
        margin: 0 !important;
        max-height: 80px;
        width: auto;
      }

      .lhci-contact {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xs) var(--spacing-lg);
      }

      .lhci-office {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xs) var(--spacing-lg);
      }

      .lhci-address,
      .lhci-phone {
        align-items: center;
        color: var(--lhci-link-color, var(--color-text));
        display: inline-flex;
        gap: var(--spacing-xs);
        line-height: 1.3;
        text-decoration: none;

        &:hover,
        &:focus-visible {
          opacity: 0.85;
        }
      }

      .lhci-icon-badge {
        align-items: center;
        background-color: var(--lhci-icon-bg, var(--color-brand, #95982d));
        border-radius: 50%;
        color: #fff;
        display: inline-flex;
        flex-shrink: 0;
        height: 35px;
        justify-content: center;
        width: 35px;
      }

      .lhci-link-text {
        font-size: 0.9rem;
      }

      .lhci-phone-text {
        font-size: 1.1rem;
        font-weight: var(--font-weight-semibold);
      }

      .lhci-buttons {
        flex-shrink: 0;
      }

      .lhci-mobile-bar {
        display: flex;
        width: 100%;

        @media (min-width: 1024px) {
          display: none;
        }

        a {
          align-items: center;
          background-color: var(--lhci-icon-bg, var(--color-brand, #95982d));
          color: #fff;
          display: flex;
          flex: 1;
          flex-direction: column;
          font-weight: var(--font-weight-semibold);
          justify-content: center;
          padding-block: var(--spacing-sm);
          text-align: center;
          text-decoration: none;
        }

        .lhci-mobile-appt {
          filter: brightness(0.85);
        }

        .lhci-mobile-small {
          display: block;
          font-size: 0.75rem;
          font-weight: var(--font-weight-normal);
        }
      }
    }
  }
</style>
