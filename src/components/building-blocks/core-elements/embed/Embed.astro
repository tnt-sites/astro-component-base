---
// `editable` is destructured-and-discarded (like `_component`) purely so it
// never leaks into ...htmlAttributes as a literal `editable="false"` DOM
// attribute -- this component has no data-prop of its own to gate, but
// RenderBlock now forwards its own editable state to every rendered
// component (see renderBlock.astro's 2026-07-28 comment).
const { html, aspectRatio = "auto", class: className, _component, editable, ...htmlAttributes } = Astro.props;
---

<div
  class:list={["embed-wrapper", aspectRatio !== "auto" && `ratio-${aspectRatio}`, className]}
  set:html={html}
  {...htmlAttributes}
/>

<style is:global>
  @layer components {
    .embed-wrapper {
      margin-top: var(--spacing-lg);

      iframe {
        border: none;
        display: block;
        height: 100%;
        width: 100%;
      }

      &.ratio-square {
        aspect-ratio: var(--ratio-square);
      }

      &.ratio-landscape {
        aspect-ratio: var(--ratio-landscape);
      }

      &.ratio-portrait {
        aspect-ratio: var(--ratio-portrait);
      }

      &.ratio-widescreen {
        aspect-ratio: var(--ratio-widescreen);
      }
    }
  }
</style>
