  "icon-play-circled2": "\ue833",
};

const { name = "", count = 1, size = "md", class: className, _component, ...rest } = Astro.props;

const glyph = name ? glyphs[name] : undefined;
const safeCount = Math.max(1, Math.min(10, Number(count) || 1));

if (!glyph) return;
---

<span class:list={["fontello-icon", `size-${size}`, className]} aria-hidden="true" {...rest}>
  {Array.from({ length: safeCount }).map(() => <span class="glyph">{glyph}</span>)}
</span>

<style>
  .fontello-icon {
    display: inline-flex;
    gap: 0.05em;
    line-height: 1;
  }

  .fontello-icon .glyph {
    font-family: fontello;
    font-style: normal;
    font-weight: normal;
  }

  .fontello-icon.size-sm .glyph {
    font-size: 0.875rem;
  }
  .fontello-icon.size-md .glyph {
    font-size: 1.25rem;
  }
  .fontello-icon.size-lg .glyph {
    font-size: 1.75rem;
  }
  .fontello-icon.size-xl .glyph {
    font-size: 2.25rem;
  }
  .fontello-icon.size-2xl .glyph {
    font-size: 3rem;
  }
</style>
