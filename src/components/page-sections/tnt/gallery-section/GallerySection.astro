---
/**
 * Nested-composition rebuild (2026-08-08, following the Astro Component
 * Starter's "Building a Page Section" doc: structured sections should reuse
 * existing building blocks rather than hand-roll markup+CSS a wrapper
 * already provides). Previously this rendered its own <div class="grid">
 * and raw <img> tags -- duplicate grid CSS that `Grid` already ships, and
 * missing `Image`'s responsive srcset/CDN-provider handling entirely.
 * Same idiom as `people/team-grid` (Grid > GridItem > Card > Image) and the
 * same "editable={false} + _structures-defined plain-data array" convention
 * as this component's sibling `tnt/before-after` (see its `pairs` prop) --
 * per-item inline click-to-edit isn't wired for plain-data array items in
 * this base; editing happens via the sidebar's array/structures editor
 * instead, which `gallery-section.cloudcannon.structure-value.yml`'s
 * `_structures.galleryItems` already defines. Public `items` prop shape
 * (`{src, alt, caption}[]`) is unchanged -- WP2Astro's band adapter
 * (`vision/compose.ts`'s `image-row` case) emits exactly this shape.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Card from "@wrappers/card/Card.astro";
import Grid from "@wrappers/grid/Grid.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

const {
  heading = "",
  headingLevel = "h2",
  items = [],
  colorScheme = "inherit",
  backgroundColor = "base",
  paddingVertical = "4xl",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["tnt-gallery-section", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  {heading && (
    <Heading level={headingLevel} size="lg" alignX="center" data-prop="heading" text={heading} />
  )}
  <Grid
    class="tnt-gallery-grid"
    gap="md"
    minItemWidth={260}
    maxItemWidth={340}
    layout="start"
    data-prop="items"
  >
    {items.map((item: { src: string; alt: string; caption: string }) => (
      <GridItem>
        <Card class="tnt-gallery-card" rounded>
          <Image
            source={item.src}
            alt={item.alt}
            aspectRatio="landscape"
            widths={[400, 600, 800]}
            sizes="340px"
            editable={false}
            slot="before"
          />
          {item.caption && (
            <SimpleText class="tnt-gallery-caption" size="sm" alignX="center" editable={false}>
              {item.caption}
            </SimpleText>
          )}
        </Card>
      </GridItem>
    ))}
  </Grid>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .tnt-gallery-grid {
      margin-top: var(--spacing-xl);
    }

    .tnt-gallery-card {
      margin-top: 0;
    }

    .tnt-gallery-card:hover .image img {
      transform: scale(1.03);
    }

    .tnt-gallery-card .image img {
      transition: transform 0.3s ease;
    }

    .tnt-gallery-caption {
      margin-top: 0;
      padding: var(--spacing-xs) var(--spacing-sm);
      color: var(--color-text-muted);
    }
  }
</style>
