---
/**
 * Ported 2026-07-19 from luxdentistrygroup's page-sections/lux/before-after
 * (a real, proven component -- no dedicated before/after comparison block
 * existed in the generic base). Found while investigating a WP2Astro
 * conversion gap: a 3rd-party Elementor widget carrying real before/after
 * treatment photos had no matching component in this base to land on, so
 * the WP2Astro adapter was falling back to a generic gallery. Rebuilt here
 * using this base's own idioms (CustomSection/Heading/SimpleText/Text/
 * ButtonGroup, generic spacing/radius/color tokens) instead of the Lux
 * fork's brand-specific tokens (navy/gold-text/near-black),
 * Each pair renders as an accessible drag-to-reveal comparison. Multiple
 * pairs form a responsive grid, so the same component supports a single
 * Elementor slider and multi-case treatment galleries without site-specific
 * markup.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  pairs = [],
  colorScheme = "inherit",
  backgroundColor = "base",
  paddingVertical = "4xl",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const imagePairs = pairs ?? [];
const isSinglePair = imagePairs.length === 1;
---

<CustomSection
  class:list={["tnt-before-after", isSinglePair && "tnt-before-after--single", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  {(eyebrow || heading || subtext) && (
    <div class="tnt-before-after__header">
      {eyebrow && (
        <SimpleText class="eyebrow" data-prop="eyebrow">
          {eyebrow}
        </SimpleText>
      )}
      {heading && <Heading level="h2" size="lg" alignX="center" data-prop="heading" text={heading} />}
      {subtext && <Text class="tnt-before-after__subtext" data-prop="subtext" text={subtext} />}
    </div>
  )}

  <div
    class:list={[
      "tnt-before-after__track-wrapper",
      isSinglePair && "tnt-before-after__track-wrapper--single",
    ]}
    data-prop="pairs"
  >
    <div class="tnt-before-after__track">
      {imagePairs.map((pair: { before?: string; after?: string; beforeAlt?: string; afterAlt?: string; beforeCaption?: string; afterCaption?: string }, index: number) => (
        <div class="tnt-before-after__pair">
          <div class="tnt-before-after__comparison" style="--tnt-comparison-position: 50%">
            <div class="tnt-before-after__layer tnt-before-after__layer--before">
              <Image
                source={pair.before}
                alt={pair.beforeAlt?.trim() ? pair.beforeAlt : pair.beforeCaption || "Before"}
                editable={false}
                class="tnt-before-after__img"
              />
            </div>
            <div class="tnt-before-after__layer tnt-before-after__layer--after">
              <Image
                source={pair.after}
                alt={pair.afterAlt?.trim() ? pair.afterAlt : pair.afterCaption || "After"}
                editable={false}
                class="tnt-before-after__img"
              />
            </div>
            <span class="tnt-before-after__label tnt-before-after__label--before">{pair.beforeCaption || "Before"}</span>
            <span class="tnt-before-after__label tnt-before-after__label--after">{pair.afterCaption || "After"}</span>
            <div class="tnt-before-after__divider" aria-hidden="true"><span>&#8596;</span></div>
            <input
              class="tnt-before-after__range"
              type="range"
              min="0"
              max="100"
              value="50"
              aria-label={`Reveal before and after image ${index + 1}`}
            />
          </div>
        </div>
      ))}
    </div>
  </div>

  {buttonSections.length > 0 && (
    <ButtonGroup class="tnt-before-after__buttons" direction="row" alignX="center" buttonSections={buttonSections} />
  )}
</CustomSection>

<style lang="pcss">
  .tnt-before-after__header {
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }

  .tnt-before-after__subtext {
    max-width: 42rem;
    margin-inline: auto;
  }

  .tnt-before-after__track-wrapper {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface, var(--color-bg-surface));
    padding: var(--spacing-md);
  }

  .tnt-before-after__track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--spacing-md);
    width: 100%;
  }

  .tnt-before-after__pair {
    min-width: 0;
  }

  .tnt-before-after--single .tnt-before-after__pair {
    max-width: 58rem;
    margin-inline: auto;
    width: 100%;
  }

  .tnt-before-after__comparison {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    touch-action: pan-y;
  }

  .tnt-before-after__layer {
    position: absolute;
    inset: 0;
  }

  .tnt-before-after__layer--before {
    z-index: 1;
    clip-path: inset(0 calc(100% - var(--tnt-comparison-position)) 0 0);
  }

  .tnt-before-after__layer--after { z-index: 0; }

  .tnt-before-after__divider {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: var(--tnt-comparison-position);
    width: 2px;
    transform: translateX(-1px);
    background: white;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 20%);
    display: flex;
    align-items: center;
    justify-content: center;

    span {
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      border: 2px solid white;
      background: var(--color-brand);
      color: white;
      box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 25%);
      font-size: 1.1rem;
    }
  }

  .tnt-before-after__range {
    position: absolute;
    z-index: 4;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: ew-resize;
    opacity: 0;
  }

  .tnt-before-after__range:focus-visible {
    opacity: 0.01;
    outline: 3px solid var(--color-brand);
    outline-offset: -3px;
  }

  .tnt-before-after__label {
    position: absolute;
    z-index: 2;
    bottom: var(--spacing-sm);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 65%);
    color: white;
    font-size: var(--font-size-sm);
    line-height: 1.2;
  }

  .tnt-before-after__label--before { left: var(--spacing-sm); }
  .tnt-before-after__label--after { right: var(--spacing-sm); }
</style>

<style lang="pcss" is:global>
  @layer page-sections {
    .tnt-before-after .tnt-before-after__layer .image {
      position: absolute;
      inset: 0;
      margin-top: 0;
      height: 100%;
      width: 100%;
      overflow: hidden;
    }

    .tnt-before-after .tnt-before-after__layer .image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".tnt-before-after__comparison").forEach((comparison) => {
    const range = comparison.querySelector<HTMLInputElement>(".tnt-before-after__range");
    if (!range || range.dataset.ready === "true") return;
    range.dataset.ready = "true";
    const update = () => comparison.style.setProperty("--tnt-comparison-position", `${range.value}%`);
    range.addEventListener("input", update);
    update();
  });
</script>
