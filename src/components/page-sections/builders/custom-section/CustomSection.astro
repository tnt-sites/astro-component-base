---
import Component from "@components/utils/renderBlock.astro";
import Image from "@core-elements/image/Image.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import Button from "@core-elements/button/Button.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  label,
  // Codex correction 2 (2026-07-21): heading/subtext/socials are structured
  // props some composers (composeSocial/composeEmbed/the Elementor template
  // placeholder) attach to a top-level custom-section. Previously these
  // weren't destructured here, so they fell into ...htmlAttributes and got
  // spread onto the <section> element as literal DOM attributes -- for
  // socials (an array/object), that serialized as the literal string
  // "[object Object]" in the built HTML. Consume + render them through the
  // same shared primitives FaqSection/Footer already use (Heading/Text/
  // ButtonGroup+Button) instead of forwarding raw props to the DOM.
  heading,
  subtext,
  socials,
  contentSections,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  backgroundImage,
  minHeight,
  rounded = false,
  class: className,
  style: userStyle,
  _component,
  ...htmlAttributes
} = Astro.props;

const socialLinks = Array.isArray(socials) ? socials : [];

const sectionStyle = [
  minHeight ? `--section-min-height: ${Number(minHeight)}px` : "",
  userStyle,
].filter(Boolean).join("; ");

const {
  source = "",
  alt = "",
  positionVertical = "top",
  positionHorizontal = "center",
  priority = false,
} = backgroundImage || {};

const slugifyLabel = (label: string) => {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}
---

<section
  class:list={["custom-section", rounded && "rounded", className]}
  data-theme={colorScheme && colorScheme !== "inherit" ? colorScheme : undefined}
  style={sectionStyle || undefined}
  {...htmlAttributes}
>
  <Image
    class:list={["background-image"]}
    source={source}
    alt={alt}
    priority={priority}
    editable={false}
    data-prop-src="backgroundImage.source"
    data-prop-alt="backgroundImage.alt"
    data-editable="image"
    positionVertical={positionVertical}
    positionHorizontal={positionHorizontal}
    background={true}
  />
  {
    backgroundColor && (
      <div class:list={["background", backgroundColor && `bg-${backgroundColor}`]} />
    )
  }

  <div class="outer-content">
    <div
      class:list={[
        "content",
        paddingHorizontal && `pad-x-${paddingHorizontal}`,
        paddingVertical && `pad-y-${paddingVertical}`,
        maxContentWidth && `max-width-${maxContentWidth}`,
      ]}
    >
      {heading && <Heading level="h2" size="lg" alignX="center" text={heading} data-prop="heading" />}
      {subtext && <Text alignX="center" text={subtext} data-prop="subtext" />}
      <slot>
        {
          contentSections && (
            <Component contentSections={contentSections} propName="contentSections" />
          )
        }
      </slot>
      {
        socialLinks.length > 0 && (
          <ButtonGroup alignX="center" class="custom-section-socials" data-prop="socials">
            {socialLinks.map((social: any) => (
              <Button
                variant="ghost"
                size="lg"
                iconName={social.icon}
                link={social.link}
                hideText="true"
                aria-label={`Visit our ${social.icon} page`}
                target="_blank"
                rel="noopener noreferrer"
              />
            ))}
          </ButtonGroup>
        )
      }
    </div>
  </div>
</section>

<style lang="pcss" is:global>
  @layer components {
    .custom-section {
      min-height: var(--section-min-height, auto);
      position: relative;

      &.rounded {
        border-radius: var(--radius-xl);
        overflow: hidden;
      }

      > .outer-content {
        height: 100%;
      }

      > .outer-content > .content {
        height: 100%;
        margin-inline: auto;
        position: relative;
        z-index: var(--layer-1);
        container-type: inline-size;

        > *:not(editable-array-item):first-child, 
        > editable-array > editable-array-item:first-child > *:first-child {
          margin-top: 0 !important;
        }

        > *:not(editable-array-item):last-child, 
        > editable-array > editable-array-item:last-child > *:last-child {
          margin-bottom: 0 !important;
        }

        &.pad-x-xs {
          padding-inline: var(--spacing-xs);
        }

        &.pad-x-sm {
          padding-inline: var(--spacing-sm);
        }

        &.pad-x-md {
          padding-inline: var(--spacing-md);
        }

        &.pad-x-lg {
          padding-inline: var(--spacing-lg);
        }

        &.pad-x-xl {
          padding-inline: var(--spacing-xl);
        }

        &.pad-x-2xl {
          padding-inline: var(--spacing-2xl);
        }

        &.pad-x-3xl {
          padding-inline: var(--spacing-3xl);
        }

        &.pad-x-4xl {
          padding-inline: var(--spacing-4xl);
        }

        &.pad-x-5xl {
          padding-inline: var(--spacing-5xl);
        }

        &.pad-x-6xl {
          padding-inline: var(--spacing-6xl);
        }

        &.pad-y-xs {
          padding-block: var(--spacing-xs);
        }

        &.pad-y-sm {
          padding-block: var(--spacing-sm);
        }

        &.pad-y-md {
          padding-block: var(--spacing-md);
        }

        &.pad-y-lg {
          padding-block: var(--spacing-lg);
        }

        &.pad-y-xl {
          padding-block: var(--spacing-xl);
        }

        &.pad-y-2xl {
          padding-block: var(--spacing-2xl);
        }

        &.pad-y-3xl {
          padding-block: var(--spacing-3xl);
        }

        &.pad-y-4xl {
          padding-block: var(--spacing-4xl);
        }

        &.pad-y-5xl {
          padding-block: var(--spacing-5xl);
        }

        &.pad-y-6xl {
          padding-block: var(--spacing-6xl);
        }

        @media (--to-sm) {
          &.pad-y-xs {
            padding-block: var(--spacing-xs);
          }

          &.pad-y-sm {
            padding-block: var(--spacing-xs);
          }

          &.pad-y-md {
            padding-block: var(--spacing-sm);
          }

          &.pad-y-lg {
            padding-block: var(--spacing-md);
          }

          &.pad-y-xl {
            padding-block: var(--spacing-md);
          }

          &.pad-y-2xl {
            padding-block: var(--spacing-lg);
          }

          &.pad-y-3xl {
            padding-block: var(--spacing-xl);
          }

          &.pad-y-4xl {
            padding-block: var(--spacing-2xl);
          }

          &.pad-y-5xl {
            padding-block: var(--spacing-3xl);
          }

          &.pad-y-6xl {
            padding-block: var(--spacing-4xl);
          }
        }

        &.max-width-xs {
          max-width: var(--content-width-xs);
        }

        &.max-width-sm {
          max-width: var(--content-width-sm);
        }

        &.max-width-md {
          max-width: var(--content-width-md);
        }

        &.max-width-lg {
          max-width: var(--content-width-lg);
        }

        &.max-width-xl {
          max-width: var(--content-width-xl);
        }

        &.max-width-2xl {
          max-width: var(--content-width-2xl);
        }

        &.max-width-3xl {
          max-width: var(--content-width-3xl);
        }
      }

      > .background {
        inset: 0;
        position: absolute;
      }

      > .background-image {
        z-index: var(--layer-1);
      }

      > .bg-base {
        background-color: var(--color-bg);
      }

      > .bg-surface {
        background-color: var(--color-bg-surface);
      }

      > .bg-accent {
        background-color: var(--color-bg-accent);
      }

      > .bg-highlight {
        background-color: var(--color-bg-highlight);
      }
    }
  }
</style>
