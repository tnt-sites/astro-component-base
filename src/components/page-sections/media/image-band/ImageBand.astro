---
import Image from "@core-elements/image/Image.astro";

const {
  source = "",
  alt = "",
  variant = "full-bleed",
  objectFit = "cover",
  maxHeight = "",
  overlayText = "",
  colorScheme = "inherit",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const bandStyle = [
  `--image-band-fit: ${objectFit}`,
  maxHeight ? `--image-band-max-height: ${maxHeight}` : "",
].filter(Boolean).join("; ");
---

<section
  class:list={["image-band", `variant-${variant}`, className]}
  data-theme={colorScheme}
  style={bandStyle}
  {...htmlAttributes}
>
  <Image
    class="image-band-image"
    source={source}
    alt={alt}
    rounded={false}
    aspectRatio="none"
    priority={false}
    data-prop-src="source"
    data-prop-alt="alt"
  />
  {overlayText && <p class="image-band-overlay">{overlayText}</p>}
</section>

<style is:global>
  .image-band,
  .image-band .image-band-image,
  .image-band .image-band-image picture {
    display: block;
    margin: 0;
    width: 100%;
  }
  .image-band { position: relative; }
  .image-band-overlay {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    margin: 0;
    color: white;
    font: 700 clamp(2rem, 5vw, 4.5rem)/1 var(--font-family-heading);
    text-shadow: 0 2px 18px rgb(0 0 0 / .55);
  }

  .image-band .image-band-image img {
    display: block;
    max-height: var(--image-band-max-height, none);
    object-fit: var(--image-band-fit, cover);
    width: 100%;
  }
</style>
