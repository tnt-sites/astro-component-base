---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  subtext = "",
  buttonSections = [],
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  variant = "default",
  subtextPosition = "before",
  class: className,
  rounded = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["cta-center", `variant-${variant}`, className]}
  maxContentWidth="lg"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  rounded={rounded}
  {...htmlAttributes}
>
  <Heading level="h2" size="xl" alignX="center" data-prop="heading" text={heading} />
  {subtextPosition !== "after" && <Text alignX="center" data-prop="subtext" text={subtext} />}
  <ButtonGroup class="buttons" buttonSections={buttonSections} alignX="center" />
  {subtextPosition === "after" && <Text alignX="center" data-prop="subtext" text={subtext} />}
</CustomSection>

<style is:global>
  .cta-center.variant-compact .heading:empty,
  .cta-center.variant-compact .text:empty {
    display: none;
  }

  .cta-center.variant-compact .buttons {
    margin-top: 0;
  }
</style>
