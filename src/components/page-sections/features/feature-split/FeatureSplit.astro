---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  subtext = "",
  buttonSections = [],
  imageSource = "",
  imageAlt = "",
  imageAspectRatio = "portrait",
  imageRounded = true,
  imageWidth = 400,
  reverse = false,
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  variant = "default",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const minSplitWidth = 720;
const featureSplitId = `feature-split-${crypto.randomUUID()}`;
const isChecklist = variant === "checklist";
---

<CustomSection
  class:list={["feature-split", `variant-${variant}`, className]}
  maxContentWidth={isChecklist ? "2xl" : "xl"}
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  data-feature-split-id={featureSplitId}
  {...htmlAttributes}
>
  <Split
    class="feature-split-layout"
    distributionMode={isChecklist ? "half" : "flexible-fixed"}
    fixedWidth={isChecklist ? undefined : String(imageWidth)}
    minSplitWidth={minSplitWidth}
    reverse={reverse}
    verticalAlignment="center"
    gap="2xl"
    reverseOrderOnMobile={true}
  >
    <Fragment slot="first">
      <SimpleText class="eyebrow" data-prop="eyebrow">
        {eyebrow}
      </SimpleText>
      <Heading level={headingLevel} size="lg" data-prop="heading" text={heading} />
      <Text class="subtext" data-prop="subtext" text={subtext} />
      <ButtonGroup
        class="feature-buttons"
        buttonSections={buttonSections}
        direction="row"
        alignX="start"
      />
    </Fragment>
    <Image
      slot="second"
      class:list={["feature-split-image", reverse && "reverse"]}
      source={imageSource}
      alt={imageAlt}
      rounded={imageRounded}
      aspectRatio={imageAspectRatio}
      data-prop-src="imageSource"
      data-prop-alt="imageAlt"
      data-editable="image"
    />
  </Split>
</CustomSection>

{
  imageAspectRatio == "portrait" && (
    <style
      is:inline
      set:html={`
        @container feature-split-layout (min-width: ${minSplitWidth}px) {
        .feature-split-image.image.rounded.reverse {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }
        .feature-split-image.image.rounded:not(.reverse) {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
        }
    `}
    />
  )
}

<style lang="pcss" is:global>
  @layer page-sections {
    .feature-split-layout {
      container-type: inline-size;
    }

    .feature-split.variant-checklist .subtext ul {
      list-style: none;
      padding-left: 0;
    }

    .feature-split.variant-checklist .subtext li {
      margin-top: var(--spacing-sm);
      padding-left: 2rem;
      position: relative;
    }

    .feature-split.variant-checklist .subtext li::before {
      color: var(--brand-accent, var(--color-text-link));
      content: "✓";
      font-weight: 700;
      left: 0;
      position: absolute;
    }

    .feature-split.variant-checklist .feature-split-image {
      margin-top: 0;
    }

    .feature-split.variant-location-map {
      min-height: 766px;
    }

    @media (max-width: 768px) {
      .feature-split.variant-location-map {
        min-height: 656px;
      }

      main.mobile-hide-split-media .feature-split-image {
        display: none;
      }
    }
  }
</style>
