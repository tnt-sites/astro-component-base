---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import FeatureItem from "@features/feature-grid/FeatureItem.astro";
import Grid from "@wrappers/grid/Grid.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  subtext = "",
  features = [],
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  _component,
  // Recognized-but-not-yet-wired-up props from the vision-pipeline's
  // "source-rows" recipe (convert.ts) -- this component's own <Grid> below
  // hardcodes its own gap/widths rather than honoring these yet. Destructure
  // them out explicitly (rather than let them fall into ...htmlAttributes)
  // so an object/array value (e.g. `columns: { base: 1 }`) never gets
  // spread onto <CustomSection> and serialized into the DOM as a literal
  // `columns="[object Object]"` attribute -- found live on 22 of
  // sound-dentistry's built pages.
  variant,
  gap,
  minItemWidth,
  maxItemWidth,
  columns,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["feature-grid", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  <SimpleText alignX="center" class="eyebrow" data-prop="eyebrow">
    {eyebrow}
  </SimpleText>
  <Heading level={headingLevel} size="lg" alignX="center" data-prop="heading" text={heading} />
  <Text class="feature-grid-subtext" alignX="center" data-prop="subtext" text={subtext} />
  <Grid
    gap="lg"
    minItemWidth="360"
    maxItemWidth="360"
    data-prop="features"
    class="feature-grid-grid"
  >
    {
      features.map((feature: any, index: number) => (
        <GridItem>
          <editable-array-item data-component="page-sections/features/feature-grid/feature-item">
            <FeatureItem {...feature} class="feature-grid-item" data-index={index} />
          </editable-array-item>
        </GridItem>
      ))
    }
  </Grid>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .feature-grid-grid {
      margin-top: var(--spacing-2xl);
    }
  }
</style>
