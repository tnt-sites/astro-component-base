---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import FeatureItem from "@features/feature-grid/FeatureItem.astro";
import Grid from "@wrappers/grid/Grid.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  features = [],
  variant = "default",
  gap = "lg",
  minItemWidth = 360,
  maxItemWidth = 360,
  /** Explicit per-breakpoint column count for a source-confirmed fixed grid -- see Grid.astro's `columns` prop doc. */
  columns,
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["feature-grid", `variant-${variant}`, className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  {
    variant !== "inline-heading" && (
      <>
        <SimpleText alignX="center" class="eyebrow" data-prop="eyebrow">
          {eyebrow}
        </SimpleText>
        <Heading level="h2" size="lg" alignX="center" data-prop="heading" text={heading} />
        <Text class="feature-grid-subtext" alignX="center" data-prop="subtext" text={subtext} />
      </>
    )
  }
  <Grid
    gap={gap}
    minItemWidth={String(minItemWidth)}
    maxItemWidth={String(maxItemWidth)}
    columns={columns}
    data-prop="features"
    class="feature-grid-grid"
  >
    {
      variant === "inline-heading" && heading && (
        <GridItem class="feature-grid-inline-heading">
          <Heading level="h2" size="md" alignX="start" data-prop="heading" text={heading} />
        </GridItem>
      )
    }
    {
      features.map((feature: any, index: number) => (
        <GridItem>
          <editable-array-item data-component="page-sections/features/feature-grid/feature-item">
            <FeatureItem {...feature} class="feature-grid-item" data-index={index} />
          </editable-array-item>
        </GridItem>
      ))
    }
  </Grid>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .feature-grid-grid {
      margin-top: var(--spacing-2xl);
    }

    .feature-grid.variant-inline-heading .feature-grid-grid {
      align-items: stretch;
      margin-top: 0;
    }

    .feature-grid.variant-inline-heading .feature-grid-grid:not(.layout-columns) {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(min(var(--min-item-width, 8.5rem), 100%), 1fr)
      );
    }

    .feature-grid.variant-inline-heading .feature-grid-grid > .grid-item,
    .feature-grid.variant-inline-heading .feature-grid-grid > editable-array-item {
      max-width: none;
      width: auto;
    }

    .feature-grid.variant-inline-heading .feature-grid-inline-heading {
      align-self: start;
      min-width: 0;
      padding: var(--spacing-sm);
    }

    .feature-grid.variant-inline-heading .feature-grid-inline-heading .heading,
    .feature-grid.variant-inline-heading .feature-grid-inline-heading .heading-text {
      hyphens: none;
      overflow-wrap: normal;
      word-break: normal;
    }

    .feature-grid.variant-inline-heading
      .feature-grid-grid
      > .grid-item:not(.feature-grid-inline-heading),
    .feature-grid.variant-inline-heading
      .feature-grid-grid
      > .grid-item:not(.feature-grid-inline-heading)
      > editable-array-item,
    .feature-grid.variant-inline-heading
      .feature-grid-grid
      > .grid-item:not(.feature-grid-inline-heading)
      .feature-item,
    .feature-grid.variant-inline-heading
      .feature-grid-grid
      > .grid-item:not(.feature-grid-inline-heading)
      .card-outer-content,
    .feature-grid.variant-inline-heading
      .feature-grid-grid
      > .grid-item:not(.feature-grid-inline-heading)
      .card-content {
      box-sizing: border-box;
      height: 100%;
    }

    .feature-grid.variant-inline-heading .feature-item {
      min-width: 0;
      padding: var(--spacing-sm) !important;
      width: auto;
    }

    .feature-grid.variant-inline-heading .feature-title {
      font-size: 0.875rem !important;
      line-height: 1.25 !important;
      margin-bottom: var(--spacing-xs) !important;
    }

    .feature-grid.variant-inline-heading .feature-description,
    .feature-grid.variant-inline-heading .feature-description p {
      font-size: 0.875rem !important;
      line-height: 1.35 !important;
      margin: 0 !important;
    }

    @media (max-width: 63.99rem) {
      .feature-grid.variant-inline-heading .feature-grid-inline-heading {
        grid-column: 1 / -1;
      }
    }
  }
</style>
